# ============================================================
# SUT - Variables de entorno de ejemplo
# ============================================================
# Copiar este archivo como .env para desarrollo local.
# Nunca subir el archivo .env real al repositorio.
# Reemplazar todos los valores "replace-with-..." antes de usar.


# ------------------------------------------------------------
# Django
# ------------------------------------------------------------

DJANGO_SECRET_KEY=replace-with-a-local-secret-key

# Desarrollo local:
DJANGO_DEBUG=True

# Hosts permitidos separados por coma.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Orígenes HTTPS confiables para protección CSRF.
# En desarrollo local puede quedar vacío.
DJANGO_CSRF_TRUSTED_ORIGINS=


# ------------------------------------------------------------
# Seguridad HTTPS
# ------------------------------------------------------------
# Desarrollo local usa HTTP, por lo que estas opciones quedan
# desactivadas.
#
# En producción deben activarse únicamente cuando el sistema
# esté servido correctamente mediante HTTPS.

DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# HSTS desactivado en desarrollo.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

DB_NAME=sut_db
DB_USER=sut_user
DB_PASSWORD=replace-with-a-local-password
DB_HOST=localhost
DB_PORT=5433


# ------------------------------------------------------------
# Email
# ------------------------------------------------------------
# Durante desarrollo puede utilizarse el backend de consola.

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Configuración SMTP opcional.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-email-user
EMAIL_HOST_PASSWORD=replace-with-email-password
EMAIL_USE_TLS=True

# Evita mantener una solicitud esperando indefinidamente
# si el servidor SMTP no responde.
EMAIL_TIMEOUT=10

DEFAULT_FROM_EMAIL=no-reply@sut.local


# ============================================================
# REFERENCIA PARA DEMO HTTPS TEMPORAL
# ============================================================
# Reemplazar el hostname de ejemplo por el generado
# temporalmente por cloudflared.
#
# Django permanece accesible únicamente mediante localhost.
# El hostname externo se configura como origen CSRF confiable.
#
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://demo.trycloudflare.com
#
# Mantener localhost disponible como vía de contingencia.
# Por eso no se fuerza redirección HTTPS en la demo.
#
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SESSION_COOKIE_SECURE=False
# DJANGO_CSRF_COOKIE_SECURE=False
#
# HSTS permanece desactivado para un hostname temporal.
#
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False


# ============================================================
# REFERENCIA PARA PRODUCCION HTTPS
# ============================================================
# No descomentar hasta disponer de HTTPS real y permanente.
#
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=sut.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://sut.example.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
#
# Empezar HSTS con un valor controlado después de comprobar HTTPS.
# Posteriormente puede aumentarse según la política de despliegue.
#
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False