# Configuración de ejemplo para desarrollo local.
# Copiar como .env y reemplazar los valores antes de ejecutar el proyecto.

DJANGO_SECRET_KEY=replace-with-a-local-secret-key
DJANGO_DEBUG=True

DB_NAME=sut_db
DB_USER=sut_user
DB_PASSWORD=replace-with-a-local-password
DB_HOST=localhost
DB_PORT=5433
