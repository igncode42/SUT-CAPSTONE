# Configuración de ejemplo para desarrollo local.
# Copiar como .env y reemplazar los valores antes de ejecutar el proyecto.

DJANGO_SECRET_KEY=replace-with-a-local-secret-key
DJANGO_DEBUG=True

DB_NAME=sut_db
DB_USER=sut_user
DB_PASSWORD=replace-with-a-local-password
DB_HOST=localhost
DB_PORT=5433

# Email
# Por defecto se usa consola durante el desarrollo.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Configuración SMTP opcional.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-email-user
EMAIL_HOST_PASSWORD=replace-with-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@sut.local